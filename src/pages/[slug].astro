---
import Layout from '../layouts/Layout.astro';
import TarjetaProducto from '../components/TarjetaProducto.astro';
import ImagenNoticia from '../components/ImagenNoticia.astro';
import { urlImagen } from '../utils/imagen';

export async function getStaticPaths() {
  // RUTA CORREGIDA CON UN SOLO ../
  const archivos = import.meta.glob('../noticias/actualidad/*.mdx', { eager: true });
  return Object.keys(archivos).map(ruta => {
    const slug = ruta.split('/').pop().split('.')[0];
    return {
      params: { slug },
      props: { noticia: archivos[ruta] },
    };
  });
}

const { noticia } = Astro.props;
const { Content, frontmatter } = (noticia as any);

const fechaLinda = new Date(frontmatter.date).toLocaleDateString('es-AR', {
  day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC'
});
---

<Layout title={`${frontmatter.title} - Actualidad Rodeg`}>
  <main class="article-container">
    
    <nav class="article-breadcrumb">
        <a href="/">Inicio</a> <span class="separator">/</span>
        <a href="/actualidad/">Actualidad</a> <span class="separator">/</span>
        <span class="current">{frontmatter.title}</span>
    </nav>

    <div class="article-header">
        <h1>{frontmatter.title}</h1>
        <p class="article-date">Publicado el {fechaLinda}</p>
    </div>

    {frontmatter.image && (
        <div class="article-hero-img">
            <img src={urlImagen(frontmatter.image)} alt={frontmatter.title} />
        </div>
    )}

    <article class="article-body">
        <Content components={{ TarjetaProducto, img: ImagenNoticia }} />
    </article>
    
  </main>
</Layout>

<style>
  .article-container { max-width: 1200px; margin: 0 auto; padding: 40px 3% 100px; font-family: 'Roboto', sans-serif; }
  .article-breadcrumb { font-size: 0.85rem; color: #6b7280; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 2rem; display: block; }
  .article-breadcrumb a { color: #6b7280; text-decoration: none; transition: color 0.2s; }
  .article-breadcrumb a:hover { color: #172dad; }
  .article-breadcrumb .separator { margin: 0 8px; color: #ccc; }
  .article-breadcrumb .current { color: #111; font-weight: 500; }
  .article-header { border-bottom: 1px solid #eaeaea; padding-bottom: 20px; margin-bottom: 40px; display: flex; flex-direction: column; align-items: flex-start; }
  .article-header h1 { font-size: 2.5rem; color: #111; font-weight: 400; line-height: 1.2; margin-bottom: 8px; margin-top: 0; }
  .article-date { font-size: 0.85rem; color: #666; font-weight: 400; margin: 0; }
  .article-hero-img { width: 100%; text-align: center; margin-bottom: 50px; background: #f9f9f9; border-radius: 12px; padding: 20px 0; border: 1px solid #eaeaea; }
  .article-hero-img img { max-width: 100%; max-height: 500px; height: auto; object-fit: contain; margin: 0 auto; border-radius: 8px; box-shadow: 0 10px 25px rgba(0,0,0,0.05); }
  .article-body { font-size: 1.15rem; color: #333; line-height: 1.8; font-weight: 400; }
  .article-body p { margin-bottom: 25px; }
  .article-body h2 { font-size: 2rem; color: #172dad; margin: 50px 0 20px; font-weight: 500; }
  .article-body :global(p:has(img)) { display: flex; flex-wrap: wrap; gap: 24px; justify-content: center; align-items: center; margin: 50px 0; }
  @media (max-width: 768px) { .article-header h1 { font-size: 2rem; } .article-body { font-size: 1.05rem; } }
</style>