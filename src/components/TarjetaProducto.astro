---
// Acá recibimos los datos que le pasemos desde la noticia
const { titulo, imagen, enlace } = Astro.props;
---

<div class="my-8 flex flex-col sm:flex-row items-center bg-white border border-[#e2e8f0] rounded-xl shadow-sm overflow-hidden hover:shadow-md transition-shadow max-w-3xl mx-auto">
    <img src={imagen} alt={titulo} class="w-full sm:w-48 h-48 object-cover" />
    <div class="p-6 flex flex-col flex-grow text-left">
        <h4 class="text-xl font-medium text-[#172dad] mb-2">{titulo}</h4>
        <p class="text-[#555] text-sm mb-4 font-light">Conocé más sobre las características técnicas de este equipo y solicitá tu cotización.</p>
        <a href={enlace} class="btn btn-orange self-start text-sm px-6 py-2">Ver producto</a>
    </div>
</div>